# ─────────────────────────────────────────────────────────────
# Credenciais necessárias para o workflow de Lead Scoring B2B
# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA versione o .env com chaves verdadeiras.
# ─────────────────────────────────────────────────────────────

# IA — classificação e scoring (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Enriquecimento — Google Maps Places API
# (https://developers.google.com/maps/documentation/places/web-service)
GOOGLE_MAPS_API_KEY=

# (Opcional) Endpoint de consulta de CNPJ na Receita Federal,
# caso utilize um provedor específico de dados cadastrais.
RECEITA_FEDERAL_API_URL=
RECEITA_FEDERAL_API_KEY=
